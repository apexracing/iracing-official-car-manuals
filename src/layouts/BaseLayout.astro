---
import '../styles/global.css';

import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  hasEnglish?: boolean;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'RaceDocs 中文模拟赛车数字手册资料库',
  hasEnglish = false,
  image = '/favicon.svg',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="zh-CN" data-language="zh" data-theme="light" data-theme-mode="system" data-has-english={String(hasEnglish)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RaceDocs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <title>{title}</title>
    <script is:inline define:vars={{ hasEnglish }}>
      (() => {
        const root = document.documentElement;
        const params = new URLSearchParams(location.search);
        const normalizeLanguage = (value) => {
          const language = value?.toLowerCase();
          if (language === 'en' || language === 'en-us' || language === 'en_us') return 'en';
          if (language === 'zh' || language === 'zh-cn' || language === 'zh_cn') return 'zh';
        };
        const normalizeTheme = (value) =>
          value === 'dark' || value === 'light' || value === 'system' ? value : undefined;

        try {
          const queryLanguage = normalizeLanguage(params.get('lang') ?? params.get('language'));
          const storedLanguage = normalizeLanguage(localStorage.getItem('racedocs-language'));
          const language = hasEnglish ? queryLanguage ?? storedLanguage ?? 'zh' : 'zh';
          root.dataset.language = language;
          root.lang = language === 'en' ? 'en' : 'zh-CN';
          if (queryLanguage) localStorage.setItem('racedocs-language', language);

          const queryTheme = normalizeTheme(params.get('theme'));
          const storedTheme = normalizeTheme(
            localStorage.getItem('racedocs-theme') ?? localStorage.getItem('tracklogic-theme'),
          );
          const themeMode = queryTheme ?? storedTheme ?? 'system';
          const theme = themeMode === 'system'
            ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : themeMode;
          root.dataset.themeMode = themeMode;
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
          if (queryTheme) localStorage.setItem('racedocs-theme', themeMode);
        } catch {}
      })();
    </script>
  </head>
  <body>
    <slot />
    <SiteFooter />
    <script>
      import '../scripts/preferences';
    </script>
    <script is:inline>
      (() => {
        const language = document.documentElement.dataset.language === 'en' ? 'en' : 'zh';
        const suffix = language === 'en' ? 'En' : 'Zh';

        for (const element of document.querySelectorAll('[data-placeholder-zh][data-placeholder-en]')) {
          const placeholder = element.dataset[`placeholder${suffix}`];
          if (placeholder !== undefined) element.setAttribute('placeholder', placeholder);
        }

        for (const element of document.querySelectorAll('[data-label-zh][data-label-en]')) {
          const label = element.dataset[`label${suffix}`];
          if (label !== undefined) element.textContent = label;
        }

        for (const element of document.querySelectorAll('[data-text-zh][data-text-en]')) {
          const text = element.dataset[`text${suffix}`];
          if (text !== undefined) element.textContent = text;
        }
      })();
    </script>
  </body>
</html>
